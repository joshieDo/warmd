#!/usr/bin/env bash
set -euo pipefail

url=${WARMD_URL:-http://dev-joshie.tail388b2e.ts.net:7878}
root=$(git rev-parse --show-toplevel)
cd "$root"

normalize() { sed -E 's#^git@([^:]+):#https://\1/#; s#\.git$##; s#/$##'; }

full=false
args_json='{}'
skip='[]'
while (($#)); do
  case $1 in
    check) ;;
    --full) full=true ;;
    --args) args_json=$2; shift ;;
    --skip) skip=$(jq -c --arg s "$2" '. + ($s | split(","))' <<<"$skip"); shift ;;
    *) echo "warmd: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done

stats=$(curl -fsS "$url/stats")
repo=${WARMD_REPO:-}
if [[ -z $repo ]]; then
  origin=$(git remote get-url origin | normalize)
  repo=$(jq -r --arg origin "$origin" '.repos[] | select(.url == $origin) | .name' <<<"$stats")
fi
[[ -n $repo ]] || { echo "warmd: $(git remote get-url origin) is not one of warmd's repos" >&2; exit 2; }

branch=$(git rev-parse --abbrev-ref HEAD)
git fetch -q origin
default=$(git symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main)
base=$(git merge-base HEAD "$default")
patch=$(mktemp)
trap 'rm -f "$patch"' EXIT
git diff --binary "$base" >"$patch"
git ls-files --others --exclude-standard -z | while IFS= read -r -d '' file; do
  git diff --binary --no-index /dev/null "$file" >>"$patch" || true
done

body=$(jq -n --arg repo "$repo" --arg sha "$base" --arg branch "$branch" --rawfile patch "$patch" \
  --argjson full "$full" --argjson args "$args_json" --argjson skip "$skip" \
  '{ repo: $repo, base: { sha: $sha }, patch: $patch, branch: $branch, session: (if $branch == "HEAD" then null else $branch end), full: $full, args: $args, skip: $skip }')
ids=$(curl -fsS -X POST "$url/check" -H 'content-type: application/json' -d "$body")
id=$(jq -r .id <<<"$ids")
full_id=$(jq -r '.full_id // empty' <<<"$ids")
echo "warmd: checking $repo $branch against ${base:0:7} (job $id)" >&2

wait_job() {
  local job state
  while :; do
    job=$(curl -fsS "$url/jobs/$1")
    state=$(jq -r .state <<<"$job")
    [[ $state == "done" || $state == "failed" ]] && break
    sleep 1
  done
  jq -r '.phases | map("\(.name) \(.secs * 10 | floor / 10)s") | join(" · ")' <<<"$job" >&2
  if [[ $state == "failed" ]]; then
    jq -r .error <<<"$job" >&2
    return 1
  fi
  printf '%s' "$job"
}

job=$(wait_job "$id")
if [[ $(jq -r .result.outcome <<<"$job") == rebase_needed ]]; then
  jq -r '"warmd: rebase onto main first, conflicts in: " + (.result.files | join(", "))' <<<"$job" >&2
  exit 1
fi
jq -r '.result.jobs[] | select((.new | length) > 0 or .output != null) |
  "== \(.name)\n" + (.new | map(.rendered) | join("")) + (.output // "")' <<<"$job"
ok=$(jq -r .result.ok <<<"$job")
if [[ $ok == true ]]; then echo "warmd: CI ok" >&2; else echo "warmd: CI found issues (these must be fixed to merge)" >&2; fi

if [[ -n $full_id ]]; then
  echo "warmd: waiting for the full set (job $full_id, advisory)" >&2
  fulljob=$(wait_job "$full_id")
  jq -r '.result.full | "== full (advisory)\n" + .notice + "\n" + (.hits | map(.rendered) | join(""))' <<<"$fulljob"
fi
[[ $ok == true ]]
