#!/usr/bin/env bash
set -euo pipefail
exec 3>&1

url=${WARMD_URL:-http://dev-joshie.tail388b2e.ts.net:7878}

usage() {
  cat >&2 <<'EOF'
usage: warmd check [--full] [--only JOBS] [--skip JOBS] [--args JSON]
       warmd track [JOB_ID]
       warmd hits [REPO] [JOB]
       warmd remote [ls | add IP:PORT | rm IP:PORT]
EOF
  exit 2
}

normalize() { sed -E 's#^git@([^:]+):#https://\1/#; s#\.git$##; s#/$##'; }
last_file() { printf '%s/warmd-last' "$(git rev-parse --git-dir)"; }

push_nudge() {
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || return 0
  if [[ -n $(git status --porcelain 2>/dev/null) ]]; then
    echo "warmd: commit and push now so CI starts in parallel: git commit -am '...' && git push -u origin $branch" >&2
  elif [[ $branch != HEAD ]] && ! git diff --quiet "@{upstream}" 2>/dev/null; then
    echo "warmd: push now so CI starts in parallel: git push -u origin $branch" >&2
  fi
}

wait_job() {
  local job state shown='[]' pending
  while :; do
    if ! job=$(curl -fsS "$url/jobs/$1" 2>/dev/null); then
      echo "warmd: job $1 is gone (warmd restarted, or the job is older than 4 days): run warmd check again" >&2
      return 1
    fi
    state=$(jq -r .state <<<"$job")
    [[ $state == "done" || $state == "failed" ]] && break
    if [[ $(jq '.progress.partial | length' <<<"$job") -gt $(jq length <<<"$shown") ]]; then
      show_jobs "$job" .progress.partial "$shown"
      shown=$(jq -c '[.progress.partial[].name]' <<<"$job")
      pending=$(jq -r '.progress.pending | join(", ")' <<<"$job")
      [[ -n $pending ]] && echo "warmd: still running: $pending (results above are final; keep working, track again later or wait)" >&2
    fi
    sleep 1
  done
  [[ $state == "done" ]] && show_jobs "$job" '(.result.jobs // [])' "$shown"
  jq -r '.phases | map("\(.name) \(.secs * 10 | floor / 10)s") | join(" · ")' <<<"$job" >&2
  if [[ $state == "failed" ]]; then
    jq -r .error <<<"$job" >&2
    return 1
  fi
  printf '%s' "$job"
}

# Prints the results of the jobs of the list at path not named in the shown JSON array: findings on stdout (fd 3), one status line each on stderr.
show_jobs() {
  jq -r --argjson shown "$3" "$2 | .[] | select(.name as \$n | \$shown | index(\$n) | not) | select((.new | length) > 0 or .output != null) |
    \"== \\(.name)\\n\" + (.new | map(.rendered) | join(\"\")) + (.output // \"\")" <<<"$1" >&3
  jq -r --argjson shown "$3" "$2 | .[] | select(.name as \$n | \$shown | index(\$n) | not) | \"warmd: \\(.name) \" + (if (.new | length) == 0 and .output == null then \"ok\" else \"\\(.new | length) new finding(s)\" + (if .output then \", interrupted\" else \"\" end) end)" <<<"$1" >&2
}

track() {
  local id=$1 full_id=${2:-} job ok fulljob not_run
  push_nudge
  echo "warmd: waiting for job $id" >&2
  job=$(wait_job "$id")
  if [[ $(jq -r .result.outcome <<<"$job") == rebase_needed ]]; then
    jq -r '"warmd: rebase onto main first, conflicts in: " + (.result.files | join(", "))' <<<"$job" >&2
    return 1
  fi
  ok=$(jq -r .result.ok <<<"$job")
  jq -r '"warmd: summary: " + (.result.jobs | map(.name + " " + (if (.new | length) == 0 and .output == null then "ok" else "\(.new | length) new" + (if .output then ", interrupted" else "" end) end)) | join(", "))' <<<"$job" >&2
  push_nudge
  jq -r '.result.broken_on_main // [] | select(length > 0) | "warmd: skipped " + join(", ") + ": it fails on main itself (not your change); the rest decides"' <<<"$job" >&2
  not_run=$(jq -r '.result.not_run // [] | join(", ")' <<<"$job")
  if [[ $ok == true && -n $not_run ]]; then
    echo "warmd: ok (partial: $not_run not run). Not CI ok: run warmd check without --only/--skip before you push or open a PR." >&2
    ok=partial
  elif [[ $ok == true ]]; then
    echo "warmd: CI ok" >&2
  else
    echo "warmd: CI found issues (these must be fixed to merge)" >&2
  fi
  if [[ -n $full_id ]]; then
    echo "warmd: waiting for the full set (job $full_id, advisory)" >&2
    fulljob=$(wait_job "$full_id")
    jq -r '.result.full | "== full (advisory)\n" + .notice + "\n" + (.hits | map(.rendered) | join(""))' <<<"$fulljob"
  fi
  [[ $ok == true ]]
}

cmd=${1:-}
[[ -n $cmd ]] || usage
shift

case $cmd in
  track)
    if [[ $# -gt 0 ]]; then
      id=$1
      full_id=${2:-}
    else
      [[ -s $(last_file) ]] || { echo "warmd: no job to track here; run warmd check first" >&2; exit 2; }
      read -r id full_id <"$(last_file)" || true
    fi
    track "$id" "${full_id:-}"
    exit $?
    ;;
  hits)
    repo=${1:-$(basename "$(git remote get-url origin 2>/dev/null | normalize)")}
    [[ -n $repo ]] || usage
    curl -fsS "$url/repos/$repo/hits" | jq -r --arg job "${2:-}" '
      "warmd: \(.jobs | to_entries | map(select($job == "" or .key == $job)) | map(.value | length) | add // 0) hits on \($repo) main \(.sha[:7])",
      (.jobs | to_entries[] | select($job == "" or .key == $job) | select(.value | length > 0) |
        "== \(.key) (\(.value | length))\n" + (.value | map(.rendered) | join("")))' --arg repo "$repo"
    exit
    ;;
  remote)
    case ${1:-ls} in
      ls) curl -fsS "$url/remotes" | jq -r '.remotes[] | "\(.addr) \(if .up then "up, \(.running) running" else "down" + (if .error then ": \(.error)" else "" end) end)"' ;;
      add) [[ $# -eq 2 ]] || usage; curl -fsS -X POST "$url/remotes" -H 'content-type: application/json' -d "$(jq -nc --arg addr "$2" '{addr: $addr}')" | jq -c . ;;
      rm) [[ $# -eq 2 ]] || usage; curl -fsS -X DELETE "$url/remotes/$2" | jq -c . ;;
      *) usage ;;
    esac
    exit
    ;;
  check) ;;
  *) usage ;;
esac

root=$(git rev-parse --show-toplevel)
cd "$root"
full=false args_json='{}' skip='[]' only='[]'
while (($#)); do
  case $1 in
    --full) full=true ;;
    --args) args_json=$2; shift ;;
    --only) only=$(jq -c --arg s "$2" '. + ($s | split(","))' <<<"$only"); shift ;;
    --skip) skip=$(jq -c --arg s "$2" '. + ($s | split(","))' <<<"$skip"); shift ;;
    *) echo "warmd: unknown argument $1" >&2; usage ;;
  esac
  shift
done

stats=$(curl -fsS "$url/stats")
repo=${WARMD_REPO:-}
if [[ -z $repo ]]; then
  origin=$(git remote get-url origin | normalize)
  repo=$(jq -r --arg origin "$origin" '.repos[] | select(.url == $origin) | .name' <<<"$stats")
fi
[[ -n $repo ]] || { echo "warmd: $(git remote get-url origin) is not one of warmd's repos" >&2; exit 2; }

branch=$(git rev-parse --abbrev-ref HEAD)
git fetch -q origin
default=$(git symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main)
base=$(git merge-base HEAD "$default")
patch=$(mktemp)
trap 'rm -f "$patch"' EXIT
git diff --binary "$base" >"$patch"
git ls-files --others --exclude-standard -z | while IFS= read -r -d '' file; do
  git diff --binary --no-index /dev/null "$file" >>"$patch" || true
done

body=$(jq -n --arg repo "$repo" --arg sha "$base" --arg branch "$branch" --rawfile patch "$patch" \
  --argjson full "$full" --argjson args "$args_json" --argjson skip "$skip" --argjson only "$only" \
  '{ repo: $repo, base: { sha: $sha }, patch: $patch, branch: $branch, session: (if $branch == "HEAD" then null else $branch end), full: $full, args: $args, skip: $skip, only: $only }')
ids=$(curl -fsS -X POST "$url/check" -H 'content-type: application/json' -d "$body")
id=$(jq -r .id <<<"$ids")
full_id=$(jq -r '.full_id // empty' <<<"$ids")
printf '%s %s\n' "$id" "$full_id" >"$(last_file)"

echo "warmd: queued $repo $branch against ${base:0:7}: job $id${full_id:+ (full: $full_id)}" >&2
push_nudge
echo "warmd: then get the result with: warmd track (job id on stdout)" >&2
echo "$id${full_id:+ $full_id}"
